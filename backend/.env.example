# Copy to .env and fill in. Never commit the real file — .gitignore covers
# .env and any .env.* variant, with this example as the only exception.

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/kurskart

# Signs the auth tokens. Any long random string; changing it invalidates every
# session that is currently signed in.
JWT_SECRET=

PORT=3000

# Cloudinary, where product images are stored. Taken from the dashboard's
# Product Environment Credentials. Missing keys only disable image uploads, but
# the secret is what signs them — an upload cannot be authorised without it, so
# keep it off the client and out of git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by `npm run seed`, which refuses to run without them rather than
# falling back to a default. Anyone holding the vendor password can read every
# customer name, address and phone number on that store's orders, so treat it
# as a real credential even though the catalogue behind it is made up.
VENDOR_PASSWORD=
SHOPPER_PASSWORD=

# `npm run seed` and `npm run seed:purge` refuse to touch a MONGO_URI that is
# not localhost unless this is set to yes. Leave it unset here and pass it on
# the command line when you genuinely mean to write to a shared database:
#
#   SEED_ALLOW=yes npm run seed
#
# SEED_ALLOW=
